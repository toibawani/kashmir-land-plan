# Editor and OS clutter

.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

# Node

node_modules/
dist/
*.log

# Python, for the icon generator in tools/

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Environment files. The app a phone downloads is a static folder and reads no
# environment variables at all. The only code that does is the photo-description
# endpoint in server/, which is not deployed and reads its values from the host
# it would run on, never from a file here. These rules are a guard so that a file
# someone reaches for out of habit cannot be committed, rather than a
# description of how the app is configured.

.env
.env.local
.env.*.local

# The folder the Pages workflow assembles before it publishes

_site/

# Scratch and archives

*.zip
*.tmp
*.bak
*.orig

# Freebuff workspace state

.freebuff/

# The officer visit pack is written outside the repo by default; this keeps a
# copy made inside it from being committed by accident.

officer-visit/
