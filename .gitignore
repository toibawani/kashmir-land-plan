.vscode/

# Node

node_modules/
dist/
*.log

# Python, for the two helper scripts (tools/make-icons.py, and the
# one-off review sheet generator at the root)

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Environment files. This project reads no environment variables at all: it is
# a static folder with no server, no keys and no API routes. These rules are a
# guard so that a file someone reaches for out of habit cannot be committed,
# rather than a description of how the app is configured.

.env
.env.local
.env.*.local

# Scratch and archives

*.zip
*.tmp
*.bak
*.orig

# Freebuff workspace state

.freebuff/
