# The project has no formatter and no dependencies, so these are the settings a
# contributor's editor has to match by hand. Three of them are enforced by
# `npm run lint`: spaces, no tabs, and no stray trailing whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, so trimming them would
# silently reflow the docs.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.png]
insert_final_newline = false
